{
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/adapters/*/*",
    "packages/auth-providers/*/*",
    "packages/cli-packages/*",
    "packages/mailer/core",
    "packages/mailer/handlers/*",
    "packages/mailer/renderers/*",
    "!packages/create-cedar-rsc-app",
    "tasks/git-hooks",
    "upgrade-scripts"
  ],
  "scripts": {
    "build": "cross-env NX_DAEMON=false nx run-many -t build",
    "build:clean": "node ./tasks/clean-build.mts",
    "build:pack": "nx run-many -t build:pack",
    "build:test-project": "node ./tasks/test-project/test-project.mts",
    "build:watch": "nx run-many -t build:watch",
    "changesets": "node ./tasks/changesets/changesets.mts",
    "check": "cross-env yarn constraints && yarn dedupe --check",
    "check:package": "nx run-many -t check:package --output-style static",
    "clean": "node ./tasks/clean.mjs",
    "e2e": "node ./tasks/run-e2e.cjs",
    "e2e:background-jobs": "node ./tasks/e2e-background-jobs/run.mts",
    "e2e:permissions": "node ./tasks/e2e-permissions/run.mts",
    "e2e:tenancy": "node ./tasks/e2e-tenancy/run.mts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate-dependency-graph": "node ./tasks/generateDependencyGraph.mjs",
    "postinstall": "node tasks/install-git-hooks.mts",
    "install:all": "concurrently -g -c auto -n install:fw \"yarn install\" npm:install:ccrsca",
    "install:ccrsca": "yarn --cwd packages/create-cedar-rsc-app install",
    "install:ccrsca:ci": "yarn --cwd packages/create-cedar-rsc-app install --inline-builds",
    "install:ci": "concurrently -g -c auto -n install:fw:ci \"yarn install --inline-builds\" npm:install:ccrsca:ci",
    "knip": "knip",
    "lint": "concurrently -c auto npm:lint:fw npm:lint:templates npm:lint:ccrsca",
    "lint:ccrsca": "yarn --cwd packages/create-cedar-rsc-app run lint",
    "lint:ccrsca:fix": "yarn --cwd packages/create-cedar-rsc-app run lint --fix",
    "lint:fix": "concurrently -c auto npm:lint:fw:fix npm:lint:templates:fix npm:lint:ccrsca:fix",
    "lint:fw": "eslint --config eslint.config.mjs --ignore-pattern Routes.jsx --ignore-pattern create-cedar-rsc-app --ignore-pattern packages/create-cedar-app/templates packages",
    "lint:fw:fix": "eslint --config eslint.config.mjs --ignore-pattern Routes.jsx --ignore-pattern create-cedar-rsc-app --ignore-pattern packages/create-cedar-app/templates packages --fix",
    "lint:templates": "concurrently -c auto \"cd packages/create-cedar-app/templates/ts && npx eslint .\" \"cd packages/create-cedar-app/templates/js && npx eslint .\"",
    "lint:templates:fix": "concurrently -c auto \"cd packages/create-cedar-app/templates/ts && npx eslint . --fix\" \"cd packages/create-cedar-app/templates/js && npx eslint . --fix\"",
    "project:copy": "node ./tasks/framework-tools/frameworkFilesToProject.mjs",
    "project:deps": "node ./tasks/framework-tools/frameworkDepsToProject.mjs",
    "project:sync": "node ./tasks/framework-tools/frameworkSyncToProject.mjs",
    "project:tarsync": "node ./tasks/framework-tools/tarsync/bin.mts",
    "rebuild-local-testing-project": "node ./tasks/rebuild-local-testing-project.mts",
    "rebuild-test-project-fixture": "node ./tasks/test-project/rebuild-test-project-fixture.mts",
    "smoke-tests": "node ./tasks/smoke-tests/smoke-tests.mjs",
    "test": "nx run-many -t test",
    "test:k6": "node ./tasks/k6-test/run-k6-tests.mts",
    "test:types": "nx run-many -t test:types",
    "test-ci": "nx run-many -t test"
  },
  "resolutions": {
    "@actions/glob/minimatch": "npm:minimatch@11.0.1",
    "@eslint/eslintrc/minimatch": "npm:minimatch@11.0.1",
    "@humanwhocodes/config-array/minimatch": "npm:minimatch@11.0.1",
    "eslint-plugin-jsx-a11y/minimatch": "npm:minimatch@11.0.1",
    "eslint-plugin-react/minimatch": "npm:minimatch@11.0.1",
    "eslint/minimatch": "npm:minimatch@11.0.1",
    "jake/minimatch": "npm:minimatch@11.0.1",
    "multimatch/minimatch": "npm:minimatch@11.0.1",
    "node-gyp@latest": "13.1.0",
