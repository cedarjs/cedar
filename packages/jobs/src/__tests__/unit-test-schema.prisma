datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "./prisma-client" // <-- a local prisma client so it doesn't interfere with the mono repo
}

// The model `yarn cedar setup jobs` adds to an app's schema
model BackgroundJob {
  id        Int       @id @default(autoincrement())
  attempts  Int       @default(0)
  handler   String
  queue     String
  priority  Int
  runAt     DateTime?
  cron      String?
  lockedAt  DateTime?
  lockedBy  String?
  lastError String?
  failedAt  DateTime?
  key       String?   @unique
  pausedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// The same model without the `key` and `pausedAt` columns, as in apps set
// up before unique keys, declared schedules and pausing jobs existed
model LegacyBackgroundJob {
  id        Int       @id @default(autoincrement())
  attempts  Int       @default(0)
  handler   String
  queue     String
  priority  Int
  runAt     DateTime?
  cron      String?
  lockedAt  DateTime?
  lockedBy  String?
  lastError String?
  failedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
