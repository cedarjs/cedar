{
  "name": "@cedarjs/uploads",
  "version": "7.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/uploads"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./s3": {
      "default": {
        "types": "./dist/s3.d.ts",
        "default": "./dist/s3.js"
      }
    },
    "./web": {
      "default": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.d.*"
  ],
  "scripts": {
    "build": "node ./build.mts",
    "build:pack": "yarn pack -o cedarjs-uploads.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn publint",
    "setup:test": "npx prisma db push --accept-data-loss --config ./src/__tests__/prisma.config.ts && npx prisma generate --config ./src/__tests__/prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@cedarjs/api": "workspace:*",
    "@cedarjs/context": "workspace:*",
    "@cedarjs/graphql-server": "workspace:*",
    "@fastify/multipart": "catalog:",
    "graphql": "catalog:",
    "mime-types": "catalog:"
  },
  "devDependencies": {
    "@apollo/client": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@cedarjs/framework-tools": "workspace:*",
    "@cedarjs/web": "workspace:*",
    "@prisma/adapter-better-sqlite3": "catalog:prisma",
    "@prisma/client": "catalog:prisma",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@uppy/aws-s3": "6.3.0",
    "@uppy/core": "6.3.0",
    "@uppy/dashboard": "6.0.2",
    "@uppy/drag-drop": "6.0.1",
    "@uppy/react": "6.1.0",
    "@uppy/xhr-upload": "6.0.1",
    "better-sqlite3": "catalog:",
    "concurrently": "catalog:",
    "esbuild": "catalog:",
    "fastify": "catalog:",
    "jsdom": "catalog:",
    "prisma": "catalog:prisma",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zx": "catalog:"
  },
  "peerDependencies": {
    "@apollo/client": "4.3.7",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@cedarjs/web": "workspace:*",
    "@uppy/aws-s3": "^6.0.0",
    "@uppy/core": "^6.0.0",
    "@uppy/dashboard": "^6.0.0",
    "@uppy/drag-drop": "^6.0.0",
    "@uppy/react": "^6.0.0",
    "@uppy/xhr-upload": "^6.0.0",
    "fastify": "5.12.8",
    "react": "19.3.1"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@cedarjs/web": {
      "optional": true
    },
    "@uppy/aws-s3": {
      "optional": true
    },
    "@uppy/core": {
      "optional": true
    },
    "@uppy/dashboard": {
      "optional": true
    },
    "@uppy/drag-drop": {
      "optional": true
    },
    "@uppy/react": {
      "optional": true
    },
    "@uppy/xhr-upload": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
