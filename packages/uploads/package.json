{
  "name": "@cedarjs/uploads",
  "version": "6.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/uploads"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./s3": {
      "default": {
        "types": "./dist/s3.d.ts",
        "default": "./dist/s3.js"
      }
    },
    "./web": {
      "default": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.d.*"
  ],
  "scripts": {
    "build": "node ./build.mts",
    "build:pack": "yarn pack -o cedarjs-uploads.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn publint",
    "setup:test": "npx prisma db push --accept-data-loss --config ./src/__tests__/prisma.config.ts && npx prisma generate --config ./src/__tests__/prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@cedarjs/api": "workspace:*",
    "@cedarjs/context": "workspace:*",
    "@cedarjs/graphql-server": "workspace:*",
    "@fastify/multipart": "9.4.0",
    "graphql": "16.14.2",
    "mime-types": "2.1.35"
  },
  "devDependencies": {
    "@apollo/client": "4.2.12",
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@cedarjs/framework-tools": "workspace:*",
    "@cedarjs/web": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/aws-lambda": "8.10.163",
    "@types/better-sqlite3": "7.6.13",
    "@types/mime-types": "2.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@uppy/aws-s3": "6.0.0",
    "@uppy/core": "6.0.0",
    "@uppy/dashboard": "6.0.0",
    "@uppy/drag-drop": "6.0.0",
    "@uppy/react": "6.0.0",
    "@uppy/xhr-upload": "6.0.0",
    "better-sqlite3": "12.11.1",
    "concurrently": "9.2.4",
    "esbuild": "0.28.2",
    "fastify": "5.12.1",
    "jsdom": "27.4.0",
    "prisma": "7.10.0",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zx": "8.8.5"
  },
  "peerDependencies": {
    "@apollo/client": "4.2.12",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@cedarjs/web": "workspace:*",
    "@uppy/aws-s3": "^6.0.0",
    "@uppy/core": "^6.0.0",
    "@uppy/dashboard": "^6.0.0",
    "@uppy/drag-drop": "^6.0.0",
    "@uppy/react": "^6.0.0",
    "@uppy/xhr-upload": "^6.0.0",
    "fastify": "5.12.1",
    "react": "19.2.8"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@cedarjs/web": {
      "optional": true
    },
    "@uppy/aws-s3": {
      "optional": true
    },
    "@uppy/core": {
      "optional": true
    },
    "@uppy/dashboard": {
      "optional": true
    },
    "@uppy/drag-drop": {
      "optional": true
    },
    "@uppy/react": {
      "optional": true
    },
    "@uppy/xhr-upload": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
