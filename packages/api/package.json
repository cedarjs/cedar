{
  "name": "@cedarjs/api",
  "version": "7.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/api"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./runtime": {
      "default": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    },
    "./auth": {
      "default": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      }
    },
    "./cache": {
      "default": {
        "types": "./dist/cache/index.d.ts",
        "default": "./dist/cache/index.js"
      }
    },
    "./logger": {
      "default": {
        "types": "./dist/logger/index.d.ts",
        "default": "./dist/logger/index.js"
      }
    },
    "./webhooks": {
      "default": {
        "types": "./dist/webhooks/index.d.ts",
        "default": "./dist/webhooks/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cedar": "./dist/bins/cedar.js",
    "cedarjs": "./dist/bins/cedar.js",
    "cfw": "./dist/bins/cfw.js",
    "redwood": "./dist/bins/redwood.js",
    "rw": "./dist/bins/redwood.js",
    "tsc": "./dist/bins/tsc.js"
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "node ./build.mts && yarn build:types",
    "build:pack": "yarn pack -o cedarjs-api.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@types/jsonwebtoken": "catalog:",
    "@whatwg-node/fetch": "catalog:",
    "cookie": "catalog:",
    "humanize-string": "catalog:",
    "jsonwebtoken": "catalog:",
    "pascalcase": "catalog:",
    "picoquery": "catalog:",
    "pino": "catalog:",
    "title-case": "catalog:"
  },
  "devDependencies": {
    "@cedarjs/framework-tools": "workspace:*",
    "@prisma/client": "catalog:prisma",
    "@types/aws-lambda": "catalog:",
    "@types/memjs": "1",
    "@types/pascalcase": "catalog:",
    "@types/split2": "catalog:",
    "concurrently": "catalog:",
    "memjs": "1.3.2",
    "publint": "catalog:",
    "redis": "6.3.1",
    "split2": "catalog:",
    "ts-toolbelt": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "memjs": "1.3.2",
    "redis": "6.3.1"
  },
  "peerDependenciesMeta": {
    "memjs": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
