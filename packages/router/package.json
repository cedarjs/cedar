{
  "name": "@cedarjs/router",
  "version": "7.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/router"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Route": "./dist/Route.js",
    "./Set": "./dist/Set.js",
    "./Link": "./dist/link.js",
    "./NavLink": "./dist/navLink.js",
    "./location": "./dist/location.js",
    "./namedRoutes": "./dist/namedRoutes.js",
    "./util": "./dist/util.js",
    "./react-util": "./dist/react-util.js",
    "./rscCss": "./dist/rsc/rscCss.js",
    "./skip-nav.css": "./skip-nav.css",
    "./serverRouter": "./dist/rsc/ServerRouter.js",
    "./RscRouter": {
      "react-server": "./dist/rsc/ServerRouter.js",
      "default": "./dist/rsc/ClientRouter.js"
    },
    "./SsrRouter": {
      "react-server": "./dist/rsc/ServerRouter.js",
      "default": "./dist/rsc/SsrRouter.js"
    },
    "./dist/*": "./dist/*.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skip-nav.css"
  ],
  "scripts": {
    "build": "node ./build.ts",
    "build:pack": "yarn pack -o cedarjs-router.tgz",
    "build:types": "tsc --build --verbose tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw --exclude-entrypoints ./skip-nav.css",
    "check:package": "concurrently npm:check:attw yarn publint",
    "test": "vitest run",
    "test:types": "tstyche",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@cedarjs/project-config": "workspace:*",
    "@cedarjs/server-store": "workspace:*",
    "react-server-dom-webpack": "catalog:",
    "ts-toolbelt": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cedarjs/auth": "workspace:*",
    "@cedarjs/framework-tools": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tstyche": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cedarjs/auth": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
