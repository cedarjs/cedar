{
  "name": "@cedarjs/router",
  "version": "6.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/router"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Route": "./dist/Route.js",
    "./Set": "./dist/Set.js",
    "./Link": "./dist/link.js",
    "./NavLink": "./dist/navLink.js",
    "./location": "./dist/location.js",
    "./namedRoutes": "./dist/namedRoutes.js",
    "./util": "./dist/util.js",
    "./react-util": "./dist/react-util.js",
    "./rscCss": "./dist/rsc/rscCss.js",
    "./serverRouter": "./dist/rsc/ServerRouter.js",
    "./RscRouter": {
      "react-server": "./dist/rsc/ServerRouter.js",
      "default": "./dist/rsc/ClientRouter.js"
    },
    "./SsrRouter": {
      "react-server": "./dist/rsc/ServerRouter.js",
      "default": "./dist/rsc/SsrRouter.js"
    },
    "./dist/*": "./dist/*.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skip-nav.css"
  ],
  "scripts": {
    "build": "node ./build.ts",
    "build:pack": "yarn pack -o cedarjs-router.tgz",
    "build:types": "tsc --build --verbose tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn publint",
    "prepublishOnly": "NODE_ENV=production yarn build",
    "test": "vitest run",
    "test:types": "tstyche",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@cedarjs/project-config": "6.0.1",
    "@cedarjs/server-store": "6.0.1",
    "react-server-dom-webpack": "19.2.7",
    "ts-toolbelt": "9.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cedarjs/auth": "6.0.1",
    "@cedarjs/framework-tools": "6.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "concurrently": "9.2.4",
    "publint": "0.3.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tstyche": "5.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@cedarjs/auth": "6.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
