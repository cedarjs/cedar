{
  "name": "@cedarjs/auth",
  "version": "6.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/auth"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./AuthProviderState": {
      "types": "./dist/AuthProvider/AuthProviderState.d.ts",
      "default": "./dist/AuthProvider/AuthProviderState.js"
    },
    "./dist/AuthProvider/AuthProviderState.js": {
      "types": "./dist/AuthProvider/AuthProviderState.d.ts",
      "default": "./dist/AuthProvider/AuthProviderState.js"
    },
    "./ServerAuthProvider": {
      "types": "./dist/AuthProvider/ServerAuthProvider.d.ts",
      "default": "./dist/AuthProvider/ServerAuthProvider.js"
    },
    "./dist/AuthProvider/ServerAuthProvider": {
      "types": "./dist/AuthProvider/ServerAuthProvider.d.ts",
      "default": "./dist/AuthProvider/ServerAuthProvider.js"
    },
    "./dist/AuthProvider/ServerAuthProvider.js": {
      "types": "./dist/AuthProvider/ServerAuthProvider.d.ts",
      "default": "./dist/AuthProvider/ServerAuthProvider.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.ts",
    "build:pack": "yarn pack -o cedarjs-auth.tgz",
    "build:types": "tsc --build --verbose tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "prepublishOnly": "NODE_ENV=production yarn build",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cedarjs/framework-tools": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "concurrently": "9.2.4",
    "msw": "2.15.0",
    "publint": "0.3.24",
    "react": "19.2.8",
    "type-fest": "5.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
