{
  "name": "@cedarjs/vite",
  "version": "6.0.0",
  "description": "Vite configuration package for CedarJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/vite"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./api": {
      "types": "./dist/api/vite-plugin-cedar-vitest-api-preset.d.ts",
      "default": "./dist/api/vite-plugin-cedar-vitest-api-preset.js"
    },
    "./buildFeServer": "./dist/buildFeServer.js",
    "./build": "./dist/build/build.js",
    "./bins/cedar-vite-build.mjs": "./bins/cedar-vite-build.mjs"
  },
  "bin": {
    "cedar-dev-fe": "./dist/devFeServer.js",
    "cedar-serve-fe": "./dist/runFeServer.js",
    "cedar-unified-dev": "./bins/cedar-unified-dev.mjs",
    "cedar-vite-build": "./bins/cedar-vite-build.mjs",
    "cedar-vite-dev": "./bins/cedar-vite-dev.mjs",
    "vite": "./bins/vite.mjs"
  },
  "files": [
    "dist",
    "bins",
    "inject"
  ],
  "scripts": {
    "build": "node ./build.ts",
    "build:pack": "yarn pack -o cedarjs-vite.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "check:attw": "yarn cedar-fwtools-attw --exclude-entrypoints ./bins/cedar-vite-build.mjs",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@babel/core": "^7.26.10",
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.8",
    "@babel/preset-typescript": "7.29.7",
    "@babel/traverse": "7.29.8",
    "@babel/types": "7.29.8",
    "@cedarjs/api": "6.0.0",
    "@cedarjs/api-server": "6.0.0",
    "@cedarjs/babel-config": "6.0.0",
    "@cedarjs/context": "6.0.0",
    "@cedarjs/graphql-server": "6.0.0",
    "@cedarjs/internal": "6.0.0",
    "@cedarjs/jobs": "6.0.0",
    "@cedarjs/project-config": "6.0.0",
    "@cedarjs/server-store": "6.0.0",
    "@cedarjs/structure": "6.0.0",
    "@cedarjs/testing": "6.0.0",
    "@swc/core": "1.16.1",
    "@universal-deploy/store": "^0.2.1",
    "@universal-deploy/vite": "^0.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "@whatwg-node/fetch": "0.10.13",
    "@whatwg-node/server": "0.11.0",
    "acorn": "8.18.0",
    "acorn-loose": "8.5.2",
    "ansis": "4.3.1",
    "busboy": "^1.6.0",
    "dotenv-defaults": "5.0.2",
    "express": "4.22.2",
    "fast-glob": "3.3.3",
    "find-my-way": "9.7.0",
    "http-proxy-middleware": "3.0.7",
    "isbot": "5.2.1",
    "magic-string": "0.30.21",
    "oxc-parser": "0.144.0",
    "react-server-dom-webpack": "19.2.8",
    "unimport": "5.7.0",
    "unplugin-auto-import": "19.3.0",
    "vite": "7.3.6",
    "vite-plugin-cjs-interop": "2.4.4",
    "vite-plugin-graphql-tag": "0.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "ws": "8.21.3",
    "yargs-parser": "21.1.1"
  },
  "devDependencies": {
    "@cedarjs/auth": "6.0.0",
    "@cedarjs/framework-tools": "6.0.0",
    "@cedarjs/router": "6.0.0",
    "@cedarjs/web": "6.0.0",
    "@dr.pogodin/react-helmet": "2.0.4",
    "@hyrious/esbuild-plugin-commonjs": "0.2.6",
    "@jridgewell/trace-mapping": "0.3.31",
    "@oxc-project/types": "^0.146.0",
    "@types/aws-lambda": "8.10.162",
    "@types/busboy": "^1",
    "@types/express": "4",
    "@types/react": "^19.2.0",
    "@types/ws": "^8",
    "@types/yargs-parser": "21.0.3",
    "concurrently": "9.2.4",
    "memfs": "4.68.1",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup": "4.62.5",
    "ts-dedent": "2.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@cedarjs/auth": "6.0.0",
    "@cedarjs/router": "6.0.0",
    "@cedarjs/web": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
