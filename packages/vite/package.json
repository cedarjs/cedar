{
  "name": "@cedarjs/vite",
  "version": "7.1.0",
  "description": "Vite configuration package for CedarJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/vite"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./api": {
      "types": "./dist/api/vite-plugin-cedar-vitest-api-preset.d.ts",
      "default": "./dist/api/vite-plugin-cedar-vitest-api-preset.js"
    },
    "./buildFeServer": "./dist/buildFeServer.js",
    "./build": "./dist/build/build.js",
    "./bins/cedar-vite-build.mjs": "./bins/cedar-vite-build.mjs"
  },
  "bin": {
    "cedar-dev-fe": "./dist/devFeServer.js",
    "cedar-serve-fe": "./dist/runFeServer.js",
    "cedar-unified-dev": "./bins/cedar-unified-dev.mjs",
    "cedar-vite-build": "./bins/cedar-vite-build.mjs",
    "cedar-vite-dev": "./bins/cedar-vite-dev.mjs",
    "vite": "./bins/vite.mjs"
  },
  "files": [
    "dist",
    "bins",
    "inject"
  ],
  "scripts": {
    "build": "node ./build.ts",
    "build:pack": "yarn pack -o cedarjs-vite.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "check:attw": "yarn cedar-fwtools-attw --exclude-entrypoints ./bins/cedar-vite-build.mjs",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/generator": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@cedarjs/api": "workspace:*",
    "@cedarjs/api-server": "workspace:*",
    "@cedarjs/babel-config": "workspace:*",
    "@cedarjs/context": "workspace:*",
    "@cedarjs/graphql-server": "workspace:*",
    "@cedarjs/internal": "workspace:*",
    "@cedarjs/jobs": "workspace:*",
    "@cedarjs/project-config": "workspace:*",
    "@cedarjs/server-store": "workspace:*",
    "@cedarjs/structure": "workspace:*",
    "@cedarjs/testing": "workspace:*",
    "@swc/core": "catalog:",
    "@universal-deploy/store": "0.3.0",
    "@universal-deploy/vite": "0.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "@whatwg-node/fetch": "catalog:",
    "@whatwg-node/server": "0.13.2",
    "acorn": "8.19.0",
    "acorn-loose": "8.5.2",
    "ansis": "catalog:",
    "busboy": "1.6.0",
    "dotenv-defaults": "catalog:",
    "esbuild": "catalog:",
    "express": "5.3.0",
    "fast-glob": "catalog:",
    "find-my-way": "9.10.0",
    "http-proxy-middleware": "3.0.10",
    "isbot": "5.2.2",
    "magic-string": "catalog:",
    "oxc-parser": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "unimport": "catalog:",
    "unplugin-auto-import": "catalog:",
    "vite": "catalog:",
    "vite-plugin-cjs-interop": "2.4.4",
    "vite-plugin-graphql-tag": "0.1.1",
    "vite-tsconfig-paths": "catalog:",
    "ws": "catalog:",
    "yargs-parser": "catalog:"
  },
  "devDependencies": {
    "@cedarjs/auth": "workspace:*",
    "@cedarjs/framework-tools": "workspace:*",
    "@cedarjs/router": "workspace:*",
    "@cedarjs/web": "workspace:*",
    "@dr.pogodin/react-helmet": "catalog:",
    "@hyrious/esbuild-plugin-commonjs": "0.2.6",
    "@jridgewell/trace-mapping": "catalog:",
    "@oxc-project/types": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/busboy": "^1",
    "@types/express": "5.0.6",
    "@types/react": "catalog:",
    "@types/ws": "^8",
    "@types/yargs-parser": "catalog:",
    "concurrently": "catalog:",
    "memfs": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup": "catalog:",
    "ts-dedent": "catalog:",
    "typescript": "catalog:",
