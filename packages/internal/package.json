{
  "name": "@cedarjs/internal",
  "version": "6.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/internal"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/dev": {
      "default": {
        "types": "./dist/dev.d.ts",
        "default": "./dist/dev.js"
      }
    },
    "./dist/files": {
      "default": {
        "types": "./dist/files.d.ts",
        "default": "./dist/files.js"
      }
    },
    "./dist/files.js": {
      "default": {
        "types": "./dist/files.d.ts",
        "default": "./dist/files.js"
      }
    },
    "./dist/gql": {
      "default": {
        "types": "./dist/gql.d.ts",
        "default": "./dist/gql.js"
      }
    },
    "./dist/project": {
      "default": {
        "types": "./dist/project.d.ts",
        "default": "./dist/project.js"
      }
    },
    "./dist/routes.js": {
      "default": {
        "types": "./dist/routes.d.ts",
        "default": "./dist/routes.js"
      }
    },
    "./dist/validateSchema": {
      "default": {
        "types": "./dist/validateSchema.d.ts",
        "default": "./dist/validateSchema.js"
      }
    },
    "./dist/build/api": {
      "default": {
        "types": "./dist/build/api.d.ts",
        "default": "./dist/build/api.js"
      }
    },
    "./dist/build/api.js": {
      "default": {
        "types": "./dist/build/api.d.ts",
        "default": "./dist/build/api.js"
      }
    },
    "./dist/build/api-graphql-transforms.js": {
      "default": {
        "types": "./dist/build/api-graphql-transforms.d.ts",
        "default": "./dist/build/api-graphql-transforms.js"
      }
    },
    "./dist/generate/generate": {
      "default": {
        "types": "./dist/generate/generate.d.ts",
        "default": "./dist/generate/generate.js"
      }
    },
    "./dist/generate/gqlormSchema": {
      "default": {
        "types": "./dist/generate/gqlormSchema.d.ts",
        "default": "./dist/generate/gqlormSchema.js"
      }
    }
  },
  "types": "dist/index.d.ts",
  "bin": {
    "cedar-gen": "./dist/generate/generate.js",
    "cedar-gen-watch": "./dist/generate/watch.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.mts",
    "build:clean-dist": "rimraf 'dist/**/*/__tests__' --glob",
    "build:pack": "yarn pack -o cedarjs-internal.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "fix:permissions": "chmod +x dist/generate/generate.js dist/generate/watch.js",
    "prepublishOnly": "NODE_ENV=production yarn build",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@babel/core": "^7.26.10",
    "@babel/parser": "7.29.8",
    "@babel/traverse": "7.29.8",
    "@cedarjs/api": "workspace:*",
    "@cedarjs/babel-config": "workspace:*",
    "@cedarjs/cli-helpers": "workspace:*",
    "@cedarjs/graphql-server": "workspace:*",
    "@cedarjs/project-config": "workspace:*",
    "@cedarjs/router": "workspace:*",
    "@cedarjs/structure": "workspace:*",
    "@cedarjs/utils": "workspace:*",
    "@graphql-codegen/add": "6.0.1",
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/client-preset": "5.3.0",
    "@graphql-codegen/core": "5.0.2",
    "@graphql-codegen/fragment-matcher": "6.0.1",
    "@graphql-codegen/plugin-helpers": "6.3.0",
    "@graphql-codegen/schema-ast": "5.0.2",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@graphql-codegen/typescript-resolvers": "5.1.8",
    "@graphql-codegen/visitor-plugin-common": "6.3.0",
    "@graphql-tools/code-file-loader": "8.1.37",
    "@graphql-tools/graphql-file-loader": "8.1.19",
    "@graphql-tools/load": "8.1.16",
    "@graphql-tools/merge": "9.2.3",
    "@prisma/dmmf": "7.10.0",
    "@prisma/internals": "7.10.0",
    "@sdl-codegen/node": "2.0.1",
    "ansis": "4.3.1",
    "chokidar": "3.6.0",
    "esbuild": "0.28.2",
    "execa": "5.1.1",
    "fast-glob": "3.3.3",
    "graphql": "16.14.2",
    "kill-port": "1.6.1",
    "magic-string": "0.30.21",
    "oxc-parser": "0.148.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "source-map": "0.8.0",
    "termi-link": "1.1.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@cedarjs/framework-tools": "workspace:*",
    "@jridgewell/trace-mapping": "0.3.31",
    "@oxc-project/types": "^0.147.0",
    "concurrently": "9.2.4",
    "graphql-tag": "2.12.7",
    "memfs": "4.69.0",
    "publint": "0.3.24",
    "ts-dedent": "2.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
