import '@cedarjs/api'
import '@cedarjs/auth'

import { getCurrentUser } from '../../../api/src/lib/auth.js'

// The user getCurrentUser() returns. getCurrentUser() returns null when it
// can't find the user; GlobalContext's currentUser type below covers that
// case. CurrentUser below extends this type, and with strictNullChecks an
// interface can't extend a type that includes null.
export type InferredCurrentUser = NonNullable<
  Awaited<ReturnType<typeof getCurrentUser>>
>

type UndefinedRoles = {
  /**
   * ⚠️ Heads-Up: This is undefined unless a roles key is returned from
   * {@link getCurrentUser()}
   *
   * You may take a look at https://cedarjs.com/docs/tutorial/chapter7/rbac for
   * a tutorial on how to add fully-fledged RBAC (Role-based Access Control) to
   * your database model.
   */
  roles?: unknown | unknown[]
}

type Overwrite<T, U> = Omit<T, keyof U> & U

declare module '@cedarjs/context' {
  interface GlobalContext {
    // Not set when nobody is logged in. Functions wrapped in useRequireAuth
    // set it to whatever getCurrentUser() returned, including null
    currentUser?: Overwrite<UndefinedRoles, InferredCurrentUser> | null
  }
}

declare module '@cedarjs/auth' {
  interface CurrentUser extends InferredCurrentUser {}
}
