{
  "name": "@cedarjs/tenancy",
  "version": "6.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/tenancy"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./web": {
      "default": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.d.*"
  ],
  "scripts": {
    "build": "node ./build.mts",
    "build:pack": "yarn pack -o cedarjs-tenancy.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn publint",
    "setup:test": "npx prisma db push --accept-data-loss --config ./src/__tests__/prisma.config.ts && npx prisma generate --config ./src/__tests__/prisma.config.ts",
    "test": "vitest run",
    "test:types": "yarn setup:test && tstyche",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@cedarjs/api": "workspace:*",
    "@cedarjs/context": "workspace:*",
    "@cedarjs/graphql-server": "workspace:*"
  },
  "devDependencies": {
    "@apollo/client": "4.2.12",
    "@arethetypeswrong/cli": "0.18.5",
    "@cedarjs/auth": "workspace:*",
    "@cedarjs/framework-tools": "workspace:*",
    "@cedarjs/router": "workspace:*",
    "@cedarjs/web": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/aws-lambda": "8.10.163",
    "@types/better-sqlite3": "7.6.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "12.11.1",
    "concurrently": "9.2.4",
    "esbuild": "0.28.2",
    "graphql": "16.14.2",
    "jsdom": "27.4.0",
    "prisma": "7.10.0",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tstyche": "5.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zx": "8.8.5"
  },
  "peerDependencies": {
    "@apollo/client": "4.2.12",
    "@cedarjs/auth": "workspace:*",
    "@cedarjs/router": "workspace:*",
    "@cedarjs/web": "workspace:*",
    "react": "19.2.8"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@cedarjs/auth": {
      "optional": true
    },
    "@cedarjs/router": {
      "optional": true
    },
    "@cedarjs/web": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
