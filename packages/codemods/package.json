{
  "name": "@cedarjs/codemods",
  "version": "7.1.0",
  "description": "Codemods to ease upgrading a CedarJS Project",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/codemods"
  },
  "license": "MIT",
  "type": "module",
  "bin": "./dist/codemods.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.mts",
    "build:pack": "yarn pack -o cedarjs-codemods.tgz",
    "build:watch": "nodemon --watch src --ignore dist --exec \"yarn build\"",
    "check:package": "yarn publint",
    "generate:codemod": "yarn node ./tasks/generateCodemod/generateCodemod.mjs",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@cedarjs/cli-helpers": "workspace:*",
    "@cedarjs/project-config": "workspace:*",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "cheerio": "catalog:",
    "deepmerge": "catalog:",
    "execa": "catalog:",
    "fast-glob": "catalog:",
    "graphql": "catalog:",
    "jscodeshift": "catalog:",
    "pascalcase": "catalog:",
    "prettier": "catalog:",
    "tasuku": "2.3.0",
    "typescript": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@cedarjs/framework-tools": "workspace:*",
    "@types/babel__core": "catalog:",
    "@types/jscodeshift": "catalog:",
    "@types/yargs": "catalog:",
    "memfs": "catalog:",
    "publint": "catalog:",
    "ts-dedent": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
