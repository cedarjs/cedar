{
  "name": "@cedarjs/gqlorm",
  "version": "6.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/gqlorm"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/queryBuilder.d.ts",
        "default": "./dist/queryBuilder.js"
      }
    },
    "./setup": {
      "default": {
        "types": "./dist/setup.d.ts",
        "default": "./dist/setup.js"
      }
    },
    "./queryBuilder": {
      "default": {
        "types": "./dist/queryBuilder.d.ts",
        "default": "./dist/queryBuilder.js"
      }
    },
    "./react/useLiveQuery": {
      "default": {
        "types": "./dist/react/useLiveQuery.d.ts",
        "default": "./dist/react/useLiveQuery.js"
      }
    },
    "./parser/queryParser": {
      "default": {
        "types": "./dist/parser/queryParser.d.ts",
        "default": "./dist/parser/queryParser.js"
      }
    },
    "./generator/graphqlGenerator": {
      "default": {
        "types": "./dist/generator/graphqlGenerator.d.ts",
        "default": "./dist/generator/graphqlGenerator.js"
      }
    },
    "./live/types": {
      "default": {
        "types": "./dist/live/types.d.ts",
        "default": "./dist/live/types.js"
      }
    },
    "./types/ast": {
      "default": {
        "types": "./dist/types/ast.d.ts",
        "default": "./dist/types/ast.js"
      }
    },
    "./types/orm": {
      "default": {
        "types": "./dist/types/orm.d.ts",
        "default": "./dist/types/orm.js"
      }
    },
    "./types/schema": {
      "default": {
        "types": "./dist/types/schema.d.ts",
        "default": "./dist/types/schema.js"
      }
    },
    "./types/typeUtils": {
      "default": {
        "types": "./dist/types/typeUtils.d.ts",
        "default": "./dist/types/typeUtils.js"
      }
    }
  },
  "main": "./dist/queryBuilder.js",
  "types": "dist/queryBuilder.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.ts",
    "build:pack": "yarn pack -o cedarjs-gqlorm.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn publint",
    "prepublishOnly": "NODE_ENV=production yarn build",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@cedarjs/server-store": "6.0.0",
    "graphql": "16.14.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "7.29.7",
    "@babel/core": "^7.26.10",
    "@cedarjs/framework-tools": "6.0.0",
    "@cedarjs/web": "6.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "concurrently": "9.2.4",
    "publint": "0.3.23",
    "tstyche": "5.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@cedarjs/web": "6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
