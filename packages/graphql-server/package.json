{
  "name": "@cedarjs/graphql-server",
  "version": "7.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/graphql-server"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./types": {
      "default": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.mts",
    "build:pack": "yarn pack -o cedarjs-graphql-server.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "test": "yarn vitest run src/",
    "test:watch": "yarn test --watch"
  },
  "dependencies": {
    "@cedarjs/api": "workspace:*",
    "@cedarjs/context": "workspace:*",
    "@envelop/core": "catalog:",
    "@envelop/disable-introspection": "6.0.0",
    "@envelop/filter-operation-type": "6.0.0",
    "@envelop/on-resolve": "4.1.1",
    "@escape.tech/graphql-armor": "3.2.0",
    "@graphql-tools/merge": "catalog:",
    "@graphql-tools/schema": "catalog:",
    "@graphql-tools/utils": "catalog:",
    "@graphql-yoga/plugin-persisted-operations": "3.24.6",
    "@opentelemetry/api": "1.10.0",
    "cookie": "catalog:",
    "graphql": "catalog:",
    "graphql-scalars": "2.0.1",
    "graphql-tag": "catalog:",
    "graphql-yoga": "catalog:",
    "lodash": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@cedarjs/framework-tools": "workspace:*",
    "@cedarjs/realtime": "workspace:*",
    "@envelop/types": "catalog:",
    "@escape.tech/graphql-armor-types": "0.7.0",
    "@types/aws-lambda": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/lodash": "catalog:",
    "@whatwg-node/promise-helpers": "^1.3.0",
    "concurrently": "catalog:",
    "fastify": "catalog:",
    "jsonwebtoken": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
