{
  "name": "@cedarjs/web",
  "version": "6.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/web"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./serverInject": {
      "types": "./dist/components/ServerInject.d.ts",
      "default": "./dist/components/ServerInject.js"
    },
    "./request": {
      "types": "./dist/server/request.d.ts",
      "default": "./dist/server/request.js"
    },
    "./middleware": {
      "types": "./dist/server/middleware.d.ts",
      "default": "./dist/server/middleware.js"
    },
    "./dist/server/middleware": {
      "types": "./dist/server/middleware.d.ts",
      "default": "./dist/server/middleware.js"
    },
    "./dist/components/*": "./dist/components/*.js",
    "./htmlTags": "./dist/components/htmlTags.js",
    "./Metadata": "./dist/components/Metadata.js",
    "./dist/apollo/suspense": "./dist/apollo/suspense.js",
    "./dist/apollo/sseLink": "./dist/apollo/sseLink.js",
    "./dist/graphql.js": "./dist/graphql.js",
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "default": "./dist/toast/index.js"
    },
    "./apollo": {
      "types": "./dist/apollo/index.d.ts",
      "default": "./dist/apollo/index.js"
    },
    "./apollo/CedarApolloProvider": {
      "types": "./dist/apollo/CedarApolloProvider.d.ts",
      "default": "./dist/apollo/CedarApolloProvider.js"
    },
    "./forceEsmApollo": "./dist/apollo/index.js"
  },
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cedar": "./dist/bins/cedar.js",
    "cedarjs": "./dist/bins/cedar.js",
    "cfw": "./dist/bins/cfw.js",
    "cross-env": "./dist/bins/cross-env.js",
    "msw": "./dist/bins/msw.js",
    "redwood": "./dist/bins/redwood.js",
    "rw": "./dist/bins/redwood.js",
    "storybook": "./dist/bins/storybook.js",
    "tsc": "./dist/bins/tsc.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.ts",
    "build:pack": "yarn pack -o cedarjs-web.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.build.json",
    "build:watch": "nodemon --watch src --ext \"js,jsx,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "prepublishOnly": "NODE_ENV=production yarn build",
    "test": "vitest run",
    "test:types": "tstyche",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@apollo/client": "4.2.7",
    "@cedarjs/server-store": "6.0.0",
    "@dr.pogodin/react-helmet": "2.0.4",
    "@whatwg-node/fetch": "0.10.13",
    "apollo-upload-client": "19.0.0",
    "cookie": "1.1.1",
    "graphql": "16.14.2",
    "graphql-sse": "2.6.0",
    "graphql-tag": "2.12.6",
    "react-hot-toast": "2.6.0",
    "rxjs": "7.8.2",
    "stacktracey": "2.2.0",
    "ts-toolbelt": "9.6.0"
  },
  "devDependencies": {
    "@apollo/client-react-streaming": "0.14.5",
    "@arethetypeswrong/cli": "0.18.5",
    "@cedarjs/auth": "6.0.0",
    "@cedarjs/framework-tools": "6.0.0",
    "@cedarjs/internal": "6.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/apollo-upload-client": "^19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "9.2.4",
    "nodemon": "3.1.14",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tstyche": "5.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@cedarjs/auth": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
