datasource db {
  provider = "mysql"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

// Define your own models here and run yarn db:save to create
// migrations for them.

model Post {
  id       Int       @id @default(autoincrement())
  title    String
  slug     String    @unique
  author   String
  body     String
  image    String?
  postedAt DateTime?
}

model User {
  id       Int           @id @default(autoincrement())
  name     String?
  email    String        @unique
  isAdmin  Boolean       @default(false)
  profiles UserProfile[]
}

model UserProfile {
  id       Int    @id @default(autoincrement())
  username String @unique
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
}

/// A shoe worn by a user.
model Shoe {
  /// The underlying ID
  id    Int   @id @default(autoincrement())
  /// Shoe color
  color Color
}

/// A photograph taken by a user.
model Photo {
  /// The underlying ID
  id       Int    @id @default(autoincrement())
  /// The name of the Photo
  name     String
  metadata Json
}

model Key {
  id        Int   @id @default(autoincrement())
  publicKey Bytes
}

/// A list of allowed colors.
enum Color {
  RED
  GREEN
  BLUE
}

model CustomData {
  id   Int    @id @default(autoincrement())
  data String
}

// This would be seeded with available car brands
model CarBrand {
  brand String @id
  cars  Car[]
}

model Car {
  id       Int      @id @default(autoincrement())
  brand    String
  carBrand CarBrand @relation(fields: [brand], references: [brand])
}

model Counter {
  id    Int    @id @default(0)
  count Int    @default(0)
}

// Order -> Customer -> Address chain, used to test that traversal continues
// through a model that already has SDL defined (Customer) to find a missing
// model further down the chain (Address).
model Order {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Customer {
  id        Int     @id @default(autoincrement())
  orders    Order[]
  addressId Int
  address   Address @relation(fields: [addressId], references: [id])
}

model Address {
  id        Int        @id @default(autoincrement())
  customers Customer[]
}

// Mirrors the user model that Cedar's dbAuth setup creates. Used to test that
// auth/sensitive fields are excluded from generated SDL
model Account {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  fullName            String
  hashedPassword      String
  salt                String
  resetToken          String?
  resetTokenExpiresAt DateTime?
  webAuthnChallenge   String?   @unique
}
