import { createCache, InMemoryClient, RedisClient } from '@cedarjs/api/cache'

import { logger } from './logger'

// The client connects to Redis the first time it's used. If it can't connect,
// the error is logged and `cache()` runs the uncached function instead
export const client =
  process.env.NODE_ENV === 'test'
    ? new InMemoryClient()
    : new RedisClient({ url: process.env.CACHE_HOST, logger })

export const { cache, cacheFindMany, cacheClient, deleteCacheKey } =
  createCache(client, {
    logger,
    timeout: 500,
  })
