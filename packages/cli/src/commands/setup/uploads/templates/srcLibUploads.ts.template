/**
 * Where files live. Each target is a provider instance; the Upload row
 * records which target holds a file so it can be read, served, and deleted
 * later. Look one up by name with `resolveTarget(targets, upload.target)`.
 */
export const targets = defineStorageTargets({
__TARGETS__})

/**
 * What clients may upload. A profile names a target and the constraints the
 * server signs into every upload token issued for it. The client never
 * supplies constraints; it names a profile.
 */
export const profiles = defineUploadProfiles({
__PROFILES__})
