import * as Sentry from '@sentry/react'

const sentryDsn =
  typeof process === 'undefined' ? undefined : process.env?.SENTRY_DSN

let dsn = ''
let environment = 'development'

if (!sentryDsn) {
  console.error(
    'Missing SENTRY_DSN environment variable. Did you forget to add it to ' +
      'your cedar.toml (or redwood.toml) in `includeEnvironmentVariables`?'
  )
  console.info(`Copy this into your cedar.toml (or redwood.toml) file:`)
  console.info(`
  includeEnvironmentVariables = [
    "SENTRY_DSN"
  ]

  `)
  console.error('Sentry is disabled for now')
} else {
  dsn = sentryDsn
  environment = process.env.NODE_ENV ?? 'development'
}

Sentry.init({
  dsn,
  environment,
  integrations: [Sentry.browserTracingIntegration()],
  tracesSampleRate: 1.0,
})

export default Sentry
