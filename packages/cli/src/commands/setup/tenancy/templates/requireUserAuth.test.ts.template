import { mockRedwoodDirective, getDirectiveName } from '@cedarjs/testing/api'

import requireUserAuth from './requireUserAuth.js'

/**
 * `context.currentUser` is typed from this app's `getCurrentUser`, which
 * selects more fields than these tests need.
 */
const asCurrentUser = (user: { id: string; memberships?: unknown[] }) =>
  user as unknown as NonNullable<typeof context.currentUser>

describe('requireUserAuth directive', () => {
  it('declares the directive sdl as schema, with the correct name', () => {
    expect(requireUserAuth.schema).toBeTruthy()
    expect(getDirectiveName(requireUserAuth.schema)).toBe('requireUserAuth')
  })

  it('throws when there is no current user', () => {
    const mockExecution = mockRedwoodDirective(requireUserAuth, {
      context: {},
    })

    expect(mockExecution).toThrowError("You don't have permission to do that.")
  })

  it('does not throw for a signed-in user, with no organization', () => {
    const mockExecution = mockRedwoodDirective(requireUserAuth, {
      context: { currentUser: asCurrentUser({ id: '1', memberships: [] }) },
    })

    expect(mockExecution).not.toThrowError()
  })
})
