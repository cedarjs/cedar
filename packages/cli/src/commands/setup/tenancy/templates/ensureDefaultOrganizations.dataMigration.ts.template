import type { PrismaClient } from 'src/lib/db'
import { ensureDefaultOrganization } from 'src/services/organizations/organizations'

const BATCH_SIZE = 100

/**
 * Existing users have no organization until this runs once: `setup tenancy`
 * only wires new signups (via the GraphQL `context` function and, for dbAuth,
 * the signup handler). Every user without a membership gets one, in batches,
 * using the same `ensureDefaultOrganization` new signups use.
 *
 * Run with `__DATA_MIGRATE_UP_COMMAND__`, after
 * `__PRISMA_MIGRATE_DEV_COMMAND__` has applied the
 * `Organization`/`Membership` migration.
 */
export default async ({ db }: { db: PrismaClient }) => {
  let cursor: string | undefined
  let hasMore = true

  while (hasMore) {
    const users = await db.user.findMany({
      take: BATCH_SIZE,
      orderBy: { id: 'asc' },
      ...(cursor ? { skip: 1, cursor: { id: cursor } } : {}),
      include: { memberships: { select: { id: true } } },
    })

    for (const user of users) {
      if (user.memberships.length === 0) {
        await ensureDefaultOrganization({
          currentUser: { id: user.id, memberships: [] },
        })
      }
    }

    cursor = users[users.length - 1]?.id
    hasMore = users.length === BATCH_SIZE
  }
}
