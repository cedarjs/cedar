import { gql } from 'graphql-tag'

import type { ValidatorDirectiveFunc } from '@cedarjs/graphql-server'
import { createValidatorDirective } from '@cedarjs/graphql-server'

import { requireUserAuth as applicationRequireUserAuth } from 'src/lib/auth'

export const schema = gql`
  """
  Use to check whether or not a user is authenticated and is associated
  with an optional set of roles, in any organization or none. For fields
  about the user rather than an organization.
  """
  directive @requireUserAuth(roles: [String]) on FIELD_DEFINITION
`

type RequireUserAuthValidate = ValidatorDirectiveFunc<{ roles?: string[] }>

const validate: RequireUserAuthValidate = ({ directiveArgs }) => {
  const { roles } = directiveArgs
  applicationRequireUserAuth({ roles })
}

const requireUserAuth = createValidatorDirective(schema, validate)

export default requireUserAuth
