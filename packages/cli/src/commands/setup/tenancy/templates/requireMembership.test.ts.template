import { mockRedwoodDirective, getDirectiveName } from '@cedarjs/testing/api'

import requireMembership from './requireMembership.js'

/**
 * `context.currentUser` is typed from this app's `getCurrentUser`, which
 * selects more fields than these tests need.
 */
const asCurrentUser = (user: { id: string; memberships?: unknown[] }) =>
  user as unknown as typeof context.currentUser

describe('requireMembership directive', () => {
  it('declares the directive sdl as schema, with the correct name', () => {
    expect(requireMembership.schema).toBeTruthy()
    expect(getDirectiveName(requireMembership.schema)).toBe(
      'requireMembership',
    )
  })

  it('throws when there is no current user', () => {
    const mockExecution = mockRedwoodDirective(requireMembership, {
      context: {},
    })

    expect(mockExecution).toThrowError()
  })

  it('throws when there is a current user but no current organization', () => {
    const mockExecution = mockRedwoodDirective(requireMembership, {
      context: { currentUser: asCurrentUser({ id: '1' }) },
    })

    expect(mockExecution).toThrowError()
  })
})
