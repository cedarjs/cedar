import { mockRedwoodDirective, getDirectiveName } from '@cedarjs/testing/api'

import requireOrgAuth from './requireOrgAuth.js'

const currentOrg = (role: string) => ({
  id: 'org-1',
  slug: 'org-1',
  role,
  membershipId: 'membership-1',
})

describe('requireOrgAuth directive', () => {
  it('declares the directive sdl as schema, with the correct name', () => {
    expect(requireOrgAuth.schema).toBeTruthy()
    expect(getDirectiveName(requireOrgAuth.schema)).toBe('requireOrgAuth')
  })

  it('throws when there is no current user', () => {
    const mockExecution = mockRedwoodDirective(requireOrgAuth, { context: {} })

    expect(mockExecution).toThrowError("You don't have permission to do that.")
  })

  it('throws when there is no current organization', () => {
    const mockExecution = mockRedwoodDirective(requireOrgAuth, {
      context: { currentUser: { id: 'user-1' } },
    })

    expect(mockExecution).toThrowError(
      'You must be a member of an organization to do that.',
    )
  })

  it('does not throw for a member of the current organization', () => {
    const mockExecution = mockRedwoodDirective(requireOrgAuth, {
      context: {
        currentUser: { id: 'user-1' },
        currentOrg: currentOrg('member'),
      },
    })

    expect(mockExecution).not.toThrowError()
  })

  it("throws when the role in the current organization isn't listed", () => {
    const mockExecution = mockRedwoodDirective(requireOrgAuth, {
      context: {
        currentUser: { id: 'user-1' },
        currentOrg: currentOrg('member'),
      },
      directiveArgs: { roles: ['owner'] },
    })

    expect(mockExecution).toThrowError("You don't have access to do that.")
  })
})
