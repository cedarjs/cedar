import type { ScenarioData } from '@cedarjs/testing/api'

import type { Membership, Organization, Prisma } from 'src/lib/db'

// This scenario assumes a dbAuth-style `User` model (`email`,
// `hashedPassword`, `salt`), plus placeholders for any other fields your
// `User` requires. Adjust the `user` fixtures below if you use a different
// auth provider.
export const standard = defineScenario<
  Prisma.OrganizationCreateArgs | Prisma.MembershipCreateArgs
>({
  organization: {
    acme: {
      data: {
        name: 'Acme Inc',
        slug: 'acme-inc',
      },
    },
  },
  membership: {
    owner: {
      data: {
        role: 'owner',
        organization: { connect: { slug: 'acme-inc' } },
        user: {
          create: {
            email: 'owner@example.com',
            hashedPassword: 'x',
            salt: 'x',
          },
        },
      },
    },
    admin: {
      data: {
        role: 'admin',
        organization: { connect: { slug: 'acme-inc' } },
        user: {
          create: {
            email: 'admin@example.com',
            hashedPassword: 'x',
            salt: 'x',
          },
        },
      },
    },
    pending: {
      data: {
        role: 'admin',
        invitationToken: 'invite-token',
        invitationExpiresAt: new Date('2999-01-01T00:00:00Z'),
        organization: { connect: { slug: 'acme-inc' } },
      },
    },
    // A pending invitation whose expiry has passed.
    expired: {
      data: {
        role: 'member',
        invitationToken: 'expired-token',
        invitationExpiresAt: new Date('2000-01-01T00:00:00Z'),
        organization: { connect: { slug: 'acme-inc' } },
      },
    },
  },
})

export type StandardScenario = ScenarioData<Organization, 'organization', 'acme'> &
  ScenarioData<
    Membership,
    'membership',
    'owner' | 'admin' | 'pending' | 'expired'
  >
