import { gql } from 'graphql-tag'

import type { ValidatorDirectiveFunc } from '@cedarjs/graphql-server'
import { createValidatorDirective } from '@cedarjs/graphql-server'

import { requireOrgAuth as applicationRequireOrgAuth } from 'src/lib/auth'

export const schema = gql`
  """
  Use to check that the signed-in user is a member of the current
  organization, with one of an optional set of roles there.
  """
  directive @requireOrgAuth(roles: [String]) on FIELD_DEFINITION
`

type RequireOrgAuthValidate = ValidatorDirectiveFunc<{ roles?: string[] }>

const validate: RequireOrgAuthValidate = ({ directiveArgs }) => {
  const { roles } = directiveArgs
  applicationRequireOrgAuth({ roles })
}

const requireOrgAuth = createValidatorDirective(schema, validate)

export default requireOrgAuth
