import type { ReactNode } from 'react'

import { OrgScope as TenancyOrgScope } from '@cedarjs/tenancy/web'
import type { OrgScopeProps as TenancyOrgScopeProps } from '@cedarjs/tenancy/web'

import { useAuth } from 'src/auth'

export interface OrgScopeProps {
  /** Overrides the `orgSlug` route param. */
  orgSlug?: string
  /** Only members with one of these roles in the organization get in. */
  roles?: string | string[]
  /**
   * Only members whose role has this permission (api/src/lib/permissions)
   * get in.
   */
  permission?: TenancyOrgScopeProps['permission']
  /**
   * The name of the route a member without one of `roles`, or without
   * `permission`, is sent to. It gets the `orgSlug` param when its path has
   * one.
   */
  unauthorized?: string
  children: ReactNode
}

/**
 * Wraps organization routes with a per-organization Apollo client and a
 * membership check, using this app's `useAuth`. Use with the router's
 * `PrivateSet wrap`, so a user who isn't signed in is sent to log in:
 *
 *   <PrivateSet wrap={OrgScope} unauthenticated="login">
 *     <Route path="/org/{orgSlug}/projects" page={ProjectsPage} name="projects" />
 *   </PrivateSet>
 *
 * Under it, `useAuth().hasPermission` and `useCurrentOrg().hasOrgRole`
 * check the user's membership in the organization, and
 * `useAuth().hasUserRole` checks `currentUser.roles`. For pages only some
 * roles in the organization may open, give the `PrivateSet` `orgRoles`. The
 * router checks the role in the route's organization with the
 * `useOrgRoles` passed to it, `<Router useAuth={useAuth}
 * useOrgRoles={useOrgRoles}>`:
 *
 *   <PrivateSet wrap={[OrgScope, OrgLayout]} unauthenticated="login" unauthorized="projects" orgRoles="owner">
 *     <Route path="/org/{orgSlug}/settings" page={SettingsPage} name="settings" />
 *   </PrivateSet>
 *
 * For pages only members with a permission may open, wrap them in a
 * component that passes `permission`:
 *
 *   const MemberManagers = ({ children }: { children: ReactNode }) => (
 *     <OrgScope permission="members.manage" unauthorized="projects">
 *       {children}
 *     </OrgScope>
 *   )
 *
 *   <Set wrap={MemberManagers}>
 *     <Route path="/org/{orgSlug}/members" page={MembersPage} name="members" />
 *   </Set>
 *
 * Routes under `OrgScope` must not carry `prerender`: `OrgScope`'s nested
 * Apollo client shadows the per-route client the prerenderer injects above
 * `App`, so a prerendered query under here would not go through it.
 */
export const OrgScope = ({
  orgSlug,
  roles,
  permission,
  unauthorized,
  children,
}: OrgScopeProps) => {
  return (
    <TenancyOrgScope
      useAuth={useAuth}
      orgSlug={orgSlug}
      roles={roles}
      permission={permission}
      unauthorized={unauthorized}
      notAMember={
        <div>
          <p>You don&apos;t have access to this organization.</p>
        </div>
      }
    >
      {children}
    </TenancyOrgScope>
  )
}
