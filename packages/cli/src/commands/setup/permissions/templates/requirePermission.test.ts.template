import { permissions } from '__PERMISSIONS_PACKAGE__'

import { mockRedwoodDirective, getDirectiveName } from '@cedarjs/testing/api'

import requirePermission from './requirePermission.js'

/** A role in packages/permissions with a permission, and that permission */
const granted = Object.entries(permissions.roles)
  .flatMap(([role, names]) => names.map((permission) => ({ role, permission })))
  .at(0)

describe('requirePermission directive', () => {
  it('declares the directive sdl as schema, with the correct name', () => {
    expect(requirePermission.schema).toBeTruthy()
    expect(getDirectiveName(requirePermission.schema)).toBe('requirePermission')
  })

  it('throws when there is no current user', () => {
    const mockExecution = mockRedwoodDirective(requirePermission, {
      context: {},
      directiveArgs: { permission: granted?.permission },
    })

    expect(mockExecution).toThrowError()
  })

  it('throws for a permission that packages/permissions does not define', () => {
    const mockExecution = mockRedwoodDirective(requirePermission, {
      context: { currentUser: {} },
      directiveArgs: { permission: 'not.defined' },
    })

    expect(mockExecution).toThrowError('Unknown permission "not.defined"')
  })

  if (granted) {
    it('throws for a user without roles', () => {
      const mockExecution = mockRedwoodDirective(requirePermission, {
        context: { currentUser: {} },
        directiveArgs: { permission: granted.permission },
      })

      expect(mockExecution).toThrowError()
    })

    it("passes when one of the user's roles has it", () => {
      const mockExecution = mockRedwoodDirective(requirePermission, {
        // One role, as a string. A list of roles works too.
        context: { currentUser: { roles: granted.role } },
        directiveArgs: { permission: granted.permission },
      })

      expect(mockExecution).not.toThrowError()
    })
  } else {
    it.todo(
      "passes when one of the user's roles has it, once a role in packages/permissions has a permission",
    )
  }
})
