{
  "name": "@cedarjs/project-config",
  "version": "7.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedarjs/cedar.git",
    "directory": "packages/project-config"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./packageManager": {
      "types": "./dist/packageManager.d.ts",
      "default": "./dist/packageManager.js"
    },
    "./workspaces": {
      "types": "./dist/workspaces.d.ts",
      "default": "./dist/workspaces.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./build.ts && run build:types",
    "build:pack": "yarn pack -o cedarjs-project-config.tgz",
    "build:types": "tsc --build --verbose ./tsconfig.json",
    "build:watch": "nodemon --watch src --ext \"js,ts,tsx\" --ignore dist --exec \"yarn build\"",
    "check:attw": "yarn cedar-fwtools-attw",
    "check:package": "concurrently npm:check:attw yarn:publint",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@prisma/internals": "catalog:prisma",
    "deepmerge": "catalog:",
    "fast-glob": "catalog:",
    "smol-toml": "catalog:",
    "string-env-interpolation": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cedarjs/framework-tools": "workspace:*",
    "concurrently": "catalog:",
    "prisma": "catalog:prisma",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "3905ed045508b861b495f8d5630d76c7a157d8f1"
}
